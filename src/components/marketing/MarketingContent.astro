---
import "../../styles/pages/marketing.css";
---

<main class="growth-page" id="projects">
    <section class="growth-shell growth-hero" id="about">
        <div class="hero-grid">
            <div class="hero-copy" data-growth-reveal style="--stagger: 0;">
                <p class="hero-kicker">Enterprise System Architect</p>
                <h1 class="growth-headline">
                    <span>High-Energy</span>
                    <span class="accent">Engineering</span>
                    <span>for Webflow.</span>
                </h1>
                <p class="hero-description">
                    We bridge the gap between creative vision and enterprise
                    performance. Deploying sophisticated Finsweet Client-First
                    systems with Vized and Xano backends.
                </p>
                <div class="hero-actions">
                    <a
                        href="#contact"
                        class="cta-primary interactive"
                        data-sound="bright">Start Project Architecture</a
                    >
                    <a
                        href="#services"
                        class="cta-secondary interactive"
                        data-sound="soft">View Ecosystems</a
                    >
                </div>
            </div>

            <aside class="hero-visual" data-growth-reveal style="--stagger: 1;">
                <div
                    class="hero-screen"
                    role="img"
                    aria-label="System dashboard"
                >
                </div>
                <article class="hero-float-card">
                    <p class="float-title">PerformanceFirst</p>
                    <p>
                        Engineered technical stack architecture for enterprise
                        lighthouse scores across 450+ deployments.
                    </p>
                </article>
            </aside>
        </div>
    </section>

    <section class="growth-shell systems-shell" id="services">
        <div class="section-head" data-growth-reveal style="--stagger: 0;">
            <h2>System Stack Components</h2>
            <p>
                The precise instrumentation required for modern digital
                experiences.
            </p>
        </div>

        <div class="systems-grid">
            <article
                class="system-card system-card-wide"
                data-growth-reveal
                style="--stagger: 1;"
            >
                <p class="system-icon">◈</p>
                <h3>Finsweet Client-First</h3>
                <p>
                    Scalable, maintainable, and predictable class systems
                    designed for multi-stakeholder enterprise teams.
                </p>
                <div class="chip-row">
                    <span>Attributes</span>
                    <span>Components</span>
                </div>
            </article>

            <article
                class="system-card system-card-dark"
                data-growth-reveal
                style="--stagger: 2;"
            >
                <p class="system-icon">⌘</p>
                <h3>Logic and Flow</h3>
                <p>
                    Automated CRM syncs, personalized user paths, and dynamic
                    content injection.
                </p>
                <a href="#projects" class="system-link">Explore Logic ↗</a>
            </article>

            <article
                class="system-card system-card-blue"
                data-growth-reveal
                style="--stagger: 3;"
            >
                <p class="system-icon">◉</p>
                <h3>Web Apps</h3>
                <p>
                    Building full-stack functionality within the Webflow
                    ecosystem. Auth, dashboards, and real-time data.
                </p>
            </article>

            <article
                class="system-card system-card-soft"
                data-growth-reveal
                style="--stagger: 4;"
            >
                <p class="system-icon graph" aria-hidden="true">⌁</p>
                <h3>Advanced Analytics</h3>
                <p>
                    Custom event tracking, GA4 implementation, and heatmapping
                    integration for data-first decisions.
                </p>
            </article>
        </div>
    </section>

    <section class="growth-shell portfolio-shell" id="projects">
        <div
            class="section-head section-head-inline"
            data-growth-reveal
            style="--stagger: 0;"
        >
            <div>
                <p class="section-kicker">Selected Systems</p>
                <h2>Portfolio</h2>
            </div>
            <a href="#" class="view-link interactive" data-sound="soft"
                >View All Work →</a
            >
        </div>

        <div class="portfolio-grid">
            <article
                class="portfolio-card"
                data-growth-reveal
                style="--stagger: 1;"
            >
                <div
                    class="portfolio-image image-one"
                    role="img"
                    aria-label="Quant Capital project preview"
                >
                </div>
                <div class="portfolio-meta">
                    <h3>Quant Capital</h3>
                    <p>Enterprise Fintech Landing and Client Portal</p>
                </div>
            </article>

            <article
                class="portfolio-card"
                data-growth-reveal
                style="--stagger: 2;"
            >
                <div
                    class="portfolio-image image-two"
                    role="img"
                    aria-label="Nebula Stream project preview"
                >
                </div>
                <div class="portfolio-meta">
                    <h3>Nebula Stream</h3>
                    <p>AI-powered content orchestration</p>
                </div>
            </article>
        </div>
    </section>

    <section class="growth-shell library-shell" id="audit">
        <div class="library-grid">
            <article
                class="library-copy"
                data-growth-reveal
                style="--stagger: 0;"
            >
                <h2>The Technical Library</h2>
                <p>
                    We contribute back to the Webflow ecosystem. Explore our
                    custom libraries and code snippets used by thousands of
                    developers.
                </p>
                <ul class="library-list">
                    <li>
                        <span class="dot">›</span>
                        <div>
                            <h3>GSAP Integration Snippets</h3>
                            <p>
                                Production-ready motion scripts for complex
                                scroll triggers and entrance systems.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="dot">•</span>
                        <div>
                            <h3>Custom CSS Variable Engine</h3>
                            <p>
                                A systematic approach to global styling inside
                                the Webflow Designer for cleaner builds.
                            </p>
                        </div>
                    </li>
                </ul>
            </article>

            <aside class="audit-panel" data-growth-reveal style="--stagger: 1;">
                <div class="audit-head">
                    <span>System Audit</span>
                    <span>Live Metrics</span>
                </div>
                <div class="audit-metric">
                    <p>Lighthouse Performance</p>
                    <strong>99.2%</strong>
                </div>
                <div class="audit-bar">
                    <span style="--fill: 99.2%;"></span>
                </div>
                <div class="audit-metric">
                    <p>Accessibility (A11Y)</p>
                    <strong>100%</strong>
                </div>
                <div class="audit-bar"><span style="--fill: 100%;"></span></div>
                <div class="audit-metric">
                    <p>Clean Code Grade</p>
                    <strong>A+</strong>
                </div>
                <div class="audit-bar"><span style="--fill: 97%;"></span></div>

                <a
                    href="#contact"
                    class="audit-button interactive"
                    data-sound="bright">Request a Free Audit</a
                >
            </aside>
        </div>
    </section>

    <section
        class="growth-shell cta-block"
        id="contact"
        data-growth-reveal
        style="--stagger: 0;"
    >
        <h2>Ready to build the Unbuildable?</h2>
        <p>
            Secure a developer who understands both the visual pixel and the
            underlying database schema. Limited availability for Q4.
        </p>
        <div class="cta-actions">
            <a href="#" class="cta-primary interactive" data-sound="bright"
                >Book Strategy Session</a
            >
        </div>
    </section>

    <footer class="growth-footer">
        <p>Studio Cobalt. Architecting digital experiences.</p>
        <div class="growth-footer-links">
            <a href="#" class="interactive" data-sound="soft">Privacy</a>
            <a href="#" class="interactive" data-sound="soft">Terms</a>
            <button
                id="growthThemeToggle"
                class="growth-mode-toggle interactive"
                data-sound="bright"
                aria-label="Toggle dark and light mode"
            >
                <span class="toggle-label">Mode Switcher</span>
            </button>
            <a href="#contact" class="interactive" data-sound="bright"
                >Request Audit</a
            >
        </div>
    </footer>
</main>
