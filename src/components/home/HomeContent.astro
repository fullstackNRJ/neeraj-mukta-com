---
import "../../styles/pages/home.css";
---

<main class="layout">
    <section class="hero" id="about">
        <p class="label">Available For Q4 2026</p>
        <h1
            class="headline"
            id="typewriter"
            data-fulltext="One Engineer. Four Perspectives. How can I help you today?"
            data-accent-start="14"
            data-accent-end="31"
        >
        </h1>
    </section>

    <section class="bento" id="work">
        <p
            class="bento-subtitle section-subtitle"
            id="bentoSubtitle"
            aria-label="Are you a?"
        >
            <span class="subtitle-word">Are</span>
            <span class="subtitle-word">you</span>
            <span class="subtitle-word">a?</span>
        </p>
        <a
            class="card card-a interactive"
            data-stagger="1"
            data-sound="bright"
            href="/startup-founder"
        >
            <div class="chip">Founder</div>
            <h2>Startup Founder</h2>
            <p>
                Focusing on high-velocity MVPs and scalable technical
                foundations to hit product-market fit faster.
            </p>
            <span class="card-cta">Explore Startup Founder</span>
        </a>
        <a
            class="card card-b interactive"
            data-stagger="2"
            data-sound="soft"
            href="/recruiter"
        >
            <div class="chip">Hiring</div>
            <h2>Recruiter</h2>
            <p>
                Full-stack proficiency with deep expertise in React, Node, and
                AWS architecture for product-minded teams.
            </p>
            <span class="card-cta">Explore Recruiter</span>
        </a>
        <a
            class="card card-c interactive"
            data-stagger="3"
            data-sound="soft"
            href="/for-agencies"
        >
            <div class="chip">Partner</div>
            <h2>Agency</h2>
            <p>
                Reliable white-label collaboration for complex builds and custom
                experiences that feel intentional.
            </p>
            <span class="card-cta">Explore Agency</span>
        </a>
        <a
            class="card card-d interactive"
            data-stagger="4"
            data-sound="bright"
            href="/for-marketing"
        >
            <div class="chip">Growth</div>
            <h2>Marketing</h2>
            <p>
                Technical SEO, Core Web Vitals optimization, and
                conversion-focused pages that load instantly.
            </p>
            <span class="card-cta">Explore Marketing</span>
        </a>
    </section>

    <section class="pathways" id="services">
        <p
            class="section-subtitle pathways-subtitle"
            id="pathwaysSubtitle"
            aria-label="I am looking for"
        >
            <span class="subtitle-word">I</span>
            <span class="subtitle-word">am</span>
            <span class="subtitle-word">looking</span>
            <span class="subtitle-word">for...</span>
        </p>
        <div class="pathways-grid">
            <a
                class="pathway-card card interactive"
                data-stagger="5"
                data-sound="deep"
                href="/javascript-typescript-mastery"
            >
                <h3>JavaScript & TypeScript Mastery</h3>
                <p>
                    High-performance product engineering in React, Next.js, and
                    modern typed architectures.
                </p>
                <div class="pathway-tags">
                    <span>Next.js</span>
                    <span>Hono.js</span>
                    <span>Astro</span>
                </div>
            </a>
            <a
                class="pathway-card card interactive"
                data-stagger="6"
                data-sound="ping"
                href="/enterprise-webflow-development"
            >
                <h3>Enterprise Webflow Development</h3>
                <p>
                    Advanced Webflow systems with Client-First and LUMOS,
                    powered by custom interactions.
                </p>
                <div class="pathway-tags">
                    <span>Client-First</span>
                    <span>LUMOS</span>
                    <span>GSAP</span>
                </div>
            </a>
            <a
                class="pathway-card card interactive"
                data-stagger="7"
                data-sound="deep"
                href="/native-cross-platform-apps"
            >
                <h3>Native & Cross-Platform Apps</h3>
                <p>
                    Mobile experiences with React Native, CapacitorJS, and Swift
                    UI tuned for speed.
                </p>
                <div class="pathway-tags">
                    <span>React Native</span>
                    <span>Capacitor</span>
                    <span>SwiftUI</span>
                </div>
            </a>
            <a
                class="pathway-card card interactive"
                data-stagger="8"
                data-sound="ping"
                href="/generative-ai-llm-solutions"
            >
                <h3>Generative AI & LLM Solutions</h3>
                <p>
                    Intelligent assistants and AI workflows spanning RAG,
                    fine-tuning, and custom automation.
                </p>
                <div class="pathway-tags">
                    <span>RAG</span>
                    <span>LLMs</span>
                    <span>AI Agents</span>
                </div>
            </a>
        </div>
    </section>

    <section class="feature" id="archive">
        <div class="feature-image interactive" data-sound="soft"></div>
        <div class="feature-copy">
            <h3>
                Crafting Digital Excellence at the Intersection of Code and
                Design.
            </h3>
            <p>
                I do not just ship code. I ship intent. By understanding the
                business objectives behind every pixel, I build software that
                delivers measurable outcomes.
            </p>
            <div class="cta-row">
                <a
                    class="btn btn-primary interactive"
                    href="/contact"
                    data-sound="bright">Work Together</a
                >
                <a
                    class="btn btn-secondary interactive"
                    href="/journal"
                    data-sound="soft">Read Journal</a
                >
            </div>
        </div>
    </section>
</main>
