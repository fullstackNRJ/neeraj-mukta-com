---
import "../../styles/pages/agency.css";
---

<main class="agency-page">
    <section class="agency-hero agency-shell" id="services">
        <div class="agency-hero-grid">
            <div class="agency-hero-copy">
                <div
                    class="agency-badge"
                    data-agency-reveal="up"
                    style="--stagger: 0;"
                >
                    <span class="badge-dot"></span>
                    Available for Q4 Partnerships
                </div>
                <h1
                    class="agency-headline"
                    data-agency-reveal="up"
                    style="--stagger: 1;"
                >
                    The Technical <br />Backbone for Your Creative Agency.
                </h1>
                <p
                    class="agency-subtext"
                    data-agency-reveal="up"
                    style="--stagger: 2;"
                >
                    High-fidelity execution for elite design teams. I bridge the
                    gap between Figma and high-performance production, acting as
                    your invisible technical extension.
                </p>
            </div>
            <div
                class="agency-hero-proof"
                data-agency-reveal="up"
                style="--stagger: 3;"
            >
                <div class="agency-avatars" aria-hidden="true">
                    <div class="agency-avatar-frame">
                        <img
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDEfjEFyikXOyJifNYPuPE3L8vAe-sLpYJ7cM5XUKXQ6WqPyjtbEegVT8Ds6y1zULwtgwvHvWZ7Jk5d7Am-RCiCysuEW3rufWU5gbO_pzFH7H5X2TECcKTUaFxzX9kiXFwhDdEp7JrftyP09B1nrxHlIeD7UQdAC01wVPtr9yriKJRApFhvVRIUn1T3Y4kn1CU-OGOSK50AuuD-hPHeXfF88p4a61IfcVbg8KQr1pRKUQSEVCKwpwYuNaDBGaKQEwsOXj9E8-TSaTUx"
                            alt="Partner avatar"
                            loading="lazy"
                        />
                    </div>
                    <div class="agency-avatar-frame">
                        <img
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuC2cvQ7X-ii6ZqGuC0Oqm0SBwbHGk9AJl5ZJTxyGqRNY_4pLx0sKZo-h0Q1uKMrJJE4MPVypcRsH_DSdJu_t-hUvo4kepFQRYoavdZb8M-hclL6_4MBDSp4fu1yUmd5k-xIJSykHbSkmxYvl-JA2YN1np1nKTUI1Ff-yjFDykbUzkSo4OViSduZlTPdCm8-WaPgjjhSg3NnFNRVxfDtrL0SsJ9rAfppOrfnATE2zyeJC0-QdWmmSJdQ6N6Wtswwp4VIc-w774bG42Tf"
                            alt="Partner avatar"
                            loading="lazy"
                        />
                    </div>
                    <div class="agency-avatar-frame">
                        <img
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuD10vVugNU1owMjPZAKMhutInELe1yccqdbr9bKrvcwfRhHGF415iU2I6o4HE1uE5XKLiQElSkEtj4eSP0MapDX1sw45I4zCLMViV2Mw4y1bUHFP7lMVYPXbqFa_s2wMJky2uOB4kvZ9i0USfVIG4Nafm-WDc-XzZ9fPDQS9RyNaTxFULICTVDfac8XZFczsnrSbuGghcprHPh4NGCTxkaNvBlf3awSlbB1ZzrzbqZluZGtyce6LhBr24_IG5-wk8AmD43_vWurt8zz"
                            alt="Partner avatar"
                            loading="lazy"
                        />
                    </div>
                </div>
                <p class="agency-trust-copy">Trusted by 12+ Global Boutiques</p>
            </div>
        </div>
    </section>

    <section class="agency-marquee" id="stack" aria-label="Technical stack">
        <div class="agency-marquee-track">
            <span class="agency-marquee-word">WEBFLOW</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">WIZED</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">XANO</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">REACT</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">GSAP</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">WEBFLOW</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">WIZED</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">XANO</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">REACT</span>
            <span
                class="material-symbols-outlined agency-marquee-separator"
                aria-hidden="true">token</span
            >
            <span class="agency-marquee-word">GSAP</span>
        </div>
    </section>

    <section class="agency-pillars agency-shell" id="partner">
        <div class="agency-section-header" data-agency-reveal="left">
            <h2 class="agency-section-title">Partner Pillars</h2>
            <p class="agency-section-desc">
                The framework of a seamless technical collaboration.
            </p>
        </div>

        <div class="pillars-grid">
            <article
                class="pillar-card pillar-card-wide"
                data-agency-reveal="up"
                style="--stagger: 0;"
            >
                <div class="pillar-card-topline">
                    <div class="pillar-icon-surface pillar-icon-surface-dark">
                        <span
                            class="material-symbols-outlined"
                            aria-hidden="true">integration_instructions</span
                        >
                    </div>
                    <span class="pillar-label">Pillar 01</span>
                </div>
                <div class="pillar-card-layout">
                    <div>
                        <h3>White-Label Ready</h3>
                        <p>
                            I integrate seamlessly into your team’s Slack,
                            ClickUp, or Linear. Your client, my code, your
                            brand. Completely invisible, highly effective.
                        </p>
                    </div>
                    <div
                        class="pillar-chip-grid"
                        aria-label="Partner workflow tools"
                    >
                        <div class="pillar-chip-box">
                            <span
                                class="material-symbols-outlined"
                                aria-hidden="true">chat</span
                            >
                            <span>Slack</span>
                        </div>
                        <div class="pillar-chip-box">
                            <span
                                class="material-symbols-outlined"
                                aria-hidden="true">task_alt</span
                            >
                            <span>Linear</span>
                        </div>
                    </div>
                </div>
            </article>

            <article
                class="pillar-card pillar-card-primary"
                data-agency-reveal="up"
                style="--stagger: 1;"
            >
                <div class="pillar-card-topline">
                    <div class="pillar-icon-surface">
                        <span
                            class="material-symbols-outlined"
                            aria-hidden="true">layers</span
                        >
                    </div>
                    <span class="pillar-label">Pillar 02</span>
                </div>
                <h3>High-Fidelity Execution</h3>
                <p>
                    I translate Figma designs into pixel-perfect, responsive
                    reality using Next.js, Webflow, or Custom JS.
                </p>
                <div class="pillar-figure">
                    <img
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAgZ1DcPQTtLOqDe8-kO_e2GlUvLYumpnUeVlouHtuD414zw2xj9S32NhBJG2my-j0ZwHDaktw8mSVrnwS88rdPvy3oV-BQTty0mLUM3Yt8BPwWN_-DKSCns4RxWycqLmy9uQmCoFlJqacAbOTLy7hpd7Y1RIRHigZsOm7E3_Quie2eUmYAfLKHErwHEMBEyF0E1Us0pe4z_3pn9-0GV16CrrbaILqkN7-sQ676-NqVtzjCwAEbJ6uiukNcacAG1nc9umqDGZNQFLOP"
                        alt="Figma interface preview"
                        loading="lazy"
                    />
                </div>
            </article>

            <article
                class="pillar-card pillar-card-performance"
                data-agency-reveal="up"
                style="--stagger: 2;"
            >
                <div class="pillar-card-topline">
                    <div
                        class="pillar-icon-surface pillar-icon-surface-secondary"
                    >
                        <span
                            class="material-symbols-outlined"
                            aria-hidden="true">speed</span
                        >
                    </div>
                    <span class="pillar-label">Pillar 03</span>
                </div>
                <h3>Performance-First</h3>
                <p>
                    Every build is optimized for 95+ Lighthouse scores, ensuring
                    your agency’s reputation for quality stays intact.
                </p>
                <div class="performance-bar-wrap">
                    <div class="performance-badge" data-counter="98">0</div>
                    <div class="performance-bar-track" aria-hidden="true">
                        <div class="performance-bar-fill"></div>
                    </div>
                    <span class="performance-bar-label">Performance</span>
                </div>
            </article>

            <article
                class="pillar-card pillar-card-support"
                data-agency-reveal="up"
                style="--stagger: 3;"
            >
                <div class="pillar-card-topline">
                    <div class="pillar-icon-surface pillar-icon-surface-muted">
                        <span
                            class="material-symbols-outlined"
                            aria-hidden="true">description</span
                        >
                    </div>
                    <span class="pillar-label">Pillar 04</span>
                </div>
                <h3>Maintenance & Support</h3>
                <p>
                    I don't just ship and disappear. I provide clear technical
                    documentation and ongoing support for smooth client
                    handovers and long-term stability.
                </p>
                <span
                    class="material-symbols-outlined pillar-terminal"
                    aria-hidden="true">terminal</span
                >
            </article>
        </div>
    </section>

    <section class="agency-praise agency-shell" id="praise">
        <div class="agency-section-header" data-agency-reveal="left">
            <h2 class="agency-section-title">Partner Praise</h2>
            <p class="agency-section-desc">
                Feedback from those who value technical precision.
            </p>
        </div>

        <div class="praise-grid">
            <article
                class="praise-card"
                data-agency-reveal="up"
                style="--stagger: 0;"
            >
                <div class="stars" aria-label="5 out of 5 stars">
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                </div>
                <p>
                    "Atelier is our go-to for complex Webflow builds. His
                    attention to detail is unmatched, especially with responsive
                    interactions."
                </p>
                <div class="praise-author">
                    <strong>Marcus Thorne</strong>
                    <span>Creative Director, Digital Studio</span>
                </div>
            </article>

            <article
                class="praise-card featured"
                data-agency-reveal="up"
                style="--stagger: 1;"
            >
                <div class="stars" aria-label="5 out of 5 stars">
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                </div>
                <p>
                    "Finding a technical partner who actually understands design
                    nuance is rare. He bridges the gap between Figma and
                    production perfectly."
                </p>
                <div class="praise-author">
                    <strong>Sarah Jenkins</strong>
                    <span>Founder, Bloom Agency</span>
                </div>
            </article>

            <article
                class="praise-card"
                data-agency-reveal="up"
                style="--stagger: 2;"
            >
                <div class="stars" aria-label="5 out of 5 stars">
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                    <span class="material-symbols-outlined" aria-hidden="true"
                        >star</span
                    >
                </div>
                <p>
                    "Seamless white-label integration. Our clients have no idea
                    they aren't talking to an in-house developer. Highly
                    reliable."
                </p>
                <div class="praise-author">
                    <strong>David Chen</strong>
                    <span>Lead Producer, Nexus Creative</span>
                </div>
            </article>
        </div>
    </section>

    <section class="agency-cta agency-shell" data-agency-reveal="up">
        <div class="cta-inner">
            <h2 class="cta-headline">Ready for High-End Execution?</h2>
            <p class="cta-subtext">
                Currently booking overflow support and partnership projects for
                the coming quarter. Let's build something technically superior.
            </p>
            <div class="cta-actions">
                <a
                    href="#partner"
                    class="agency-cta-primary interactive"
                    data-sound="bright">Discuss a Partnership</a
                >
                <a
                    href="#services"
                    class="agency-cta-secondary interactive"
                    data-sound="soft">Overflow Support</a
                >
            </div>
        </div>
    </section>
</main>
