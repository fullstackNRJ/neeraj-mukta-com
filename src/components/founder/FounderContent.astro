---
import "../../styles/pages/founder.css";
---

<main class="layout founder-page" id="main-content">
    <section class="founder-hero" data-founder-reveal="up">
        <span class="founder-badge">The Digital Curator</span>
        <h1>
            From Idea to Market-Ready
            <span>MVP in 4 Weeks.</span>
        </h1>
        <p>
            We build high-performance digital products for visionary founders.
            Engineering precision meets editorial aesthetics so you can launch,
            learn, and iterate fast.
        </p>
        <div class="founder-actions">
            <a
                class="btn btn-primary interactive"
                href="mailto:admin@neerajmukta.com"
                data-sound="bright">Start Your Project</a
            >
            <a
                class="btn btn-secondary interactive"
                href="/#work"
                data-sound="soft">View Portfolio</a
            >
        </div>
    </section>

    <section class="logo-strip" aria-label="Technology stack partners">
        <div class="logo-track">
            <span>Next.js</span>
            <span>Cloudflare</span>
            <span>OpenAI</span>
            <span>Tailwind</span>
            <span>TypeScript</span>
            <span>Framer</span>
            <span>Postgres</span>
            <span>Next.js</span>
            <span>Cloudflare</span>
            <span>OpenAI</span>
            <span>Tailwind</span>
            <span>TypeScript</span>
            <span>Framer</span>
            <span>Postgres</span>
        </div>
    </section>

    <section class="founder-grid">
        <article
            class="founder-card founder-card-wide"
            data-founder-reveal="left"
        >
            <p class="founder-kicker">Performance Audit</p>
            <h2>
                Average Launch Time:
                <span class="accent" data-counter="30" data-suffix=" Days"
                    >0 Days</span
                >
            </h2>
            <p>
                Our sprint-based methodology eliminates friction, moving you
                from concept to validated market entry faster than traditional
                agencies.
            </p>
            <div class="founder-chart" aria-hidden="true">
                <span style="--h: 22%"></span>
                <span style="--h: 38%"></span>
                <span style="--h: 61%"></span>
                <span style="--h: 78%"></span>
            </div>
        </article>

        <article class="founder-card" data-founder-reveal="right">
            <div class="founder-icon">🛡</div>
            <h2>
                <span data-counter="99.9" data-suffix="%">0%</span>
            </h2>
            <p class="founder-subline">Uptime Architecture</p>
            <small
                >Rock-solid infrastructure built on edge-computing principles.</small
            >
        </article>

        <article
            class="founder-card founder-card-media"
            data-founder-reveal="up"
        >
            <h3>Scalability First</h3>
            <p>
                Built to handle 10 to 10M users without a single line of code
                change in infrastructure.
            </p>
            <div class="media-panel"></div>
        </article>

        <article
            class="founder-card founder-card-wide founder-card-copy"
            data-founder-reveal="up"
        >
            <h3>Precision Design</h3>
            <p>
                We do not just build; we curate experiences that command
                attention. Every pixel is an intentional choice.
            </p>
            <div class="spark-ring" aria-hidden="true">✦</div>
        </article>
    </section>
</main>
