---
import "../../styles/pages/recruiter.css";
---

<main class="layout recruiter-page" id="main-content">
    <section class="recruiter-hero">
        <div>
            <h1
                class="recruiter-headline"
                data-recruiter-reveal="up"
                style="--stagger: 0;"
            >
                <span>Building Products,</span>
                <span>Not Just Code</span>
            </h1>
            <p
                class="recruiter-subtext"
                data-recruiter-reveal="up"
                style="--stagger: 1;"
            >
                A product-focused engineer bridging the gap between high-level
                business strategy and technical execution. Focused on delivering
                measurable user impact through scalable architecture.
            </p>
        </div>

        <figure
            class="recruiter-photo-card"
            data-recruiter-reveal="right"
            style="--stagger: 2;"
            aria-label="Professional profile placeholder"
            data-tilt
        >
            <div class="photo-placeholder" aria-hidden="true"></div>
            <div class="recruiter-status-chip">
                <span class="status-dot"></span>
                <span class="status-text">
                    <span class="status-label">Status</span>
                    <span class="status-value">Open for Impact</span>
                </span>
            </div>
        </figure>
    </section>

    <section
        class="pillars-section"
        data-recruiter-reveal="up"
        style="--stagger: 0;"
    >
        <div class="pillars-header">
            <h2 class="recruiter-section-heading">Product Mindset</h2>
            <span class="pillars-eyebrow">Pillars of Execution</span>
        </div>

        <div class="pillars-grid">
            <article
                class="pillar-card"
                data-recruiter-reveal="left"
                style="--stagger: 1;"
            >
                <span class="pillar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path
                            d="M7 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm10 0a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM2 19c0-2.2 2.3-4 5-4s5 1.8 5 4M12 19c0-2.2 2.3-4 5-4s5 1.8 5 4"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"></path>
                    </svg>
                </span>
                <h3 class="pillar-title">User Centricity</h3>
                <p class="pillar-body">
                    Every line of code starts with a why. I prioritize
                    empathy-driven development to ensure we solve actual human
                    problems.
                </p>
                <div class="pillar-impact">
                    <span class="impact-eyebrow">Impact</span>
                    <p class="impact-text">
                        Reduced churn by <strong
                            data-counter="34"
                            data-suffix="%">0%</strong
                        > through intuitive UX overhaul.
                    </p>
                </div>
            </article>

            <article
                class="pillar-card"
                data-recruiter-reveal="up"
                style="--stagger: 2;"
            >
                <span class="pillar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect
                            x="3"
                            y="4"
                            width="8"
                            height="6"
                            stroke="currentColor"
                            stroke-width="1.6"></rect>
                        <rect
                            x="13"
                            y="14"
                            width="8"
                            height="6"
                            stroke="currentColor"
                            stroke-width="1.6"></rect>
                        <path
                            d="M11 7h2v6h2"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </span>
                <h3 class="pillar-title">Systems Thinking</h3>
                <p class="pillar-body">
                    Designing for the future without over-engineering the
                    present. I build modular systems that scale with the
                    business roadmap.
                </p>
                <div class="pillar-impact">
                    <span class="impact-eyebrow">Impact</span>
                    <p class="impact-text">
                        <strong data-counter="99.9" data-suffix="%">0%</strong> uptime
                        maintained during 3x traffic spike.
                    </p>
                </div>
            </article>

            <article
                class="pillar-card"
                data-recruiter-reveal="right"
                style="--stagger: 3;"
            >
                <span class="pillar-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle
                            cx="11"
                            cy="11"
                            r="7"
                            stroke="currentColor"
                            stroke-width="1.6"></circle>
                        <path
                            d="M11 7v4l3 2m6 6-4-4"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </span>
                <h3 class="pillar-title">Roadmap Strategy</h3>
                <p class="pillar-body">
                    Balancing technical debt with feature velocity. I align
                    engineering efforts with product milestones to maximize ROI.
                </p>
                <div class="pillar-impact">
                    <span class="impact-eyebrow">Impact</span>
                    <p class="impact-text">
                        Accelerated time-to-market by <strong
                            data-counter="3"
                            data-suffix=" months">0 months</strong
                        > via agile refactor.
                    </p>
                </div>
            </article>
        </div>
    </section>

    <section class="history-section" id="experience">
        <div class="pillars-header">
            <h2 class="recruiter-section-heading">Professional History</h2>
        </div>

        <div class="history-list">
            <article
                class="history-row"
                data-recruiter-reveal="up"
                style="--stagger: 0;"
            >
                <div class="history-meta">
                    <span class="history-dates">2021 - Present</span>
                    <span class="history-title">Principal Engineer</span>
                    <span class="history-company">Fintech Scaleup</span>
                </div>
                <div class="history-body">
                    <h3 class="history-role">
                        Leading the Core Transaction Engine
                    </h3>
                    <p class="history-desc">
                        Orchestrated the migration of legacy payment processing
                        to a micro-services architecture, enabling cross-border
                        support for 24 new currencies.
                    </p>
                </div>
                <div class="history-tags">
                    <span class="tech-tag">Golang</span>
                    <span class="tech-tag">AWS</span>
                    <span class="tech-tag">Kubernetes</span>
                </div>
                <div class="history-outcome">
                    <span class="outcome-label">Business Outcome</span>
                    <span class="outcome-value">$2.4M yearly savings</span>
                </div>
            </article>

            <article
                class="history-row"
                data-recruiter-reveal="up"
                style="--stagger: 1;"
            >
                <div class="history-meta">
                    <span class="history-dates">2018 - 2021</span>
                    <span class="history-title">Senior Product Engineer</span>
                    <span class="history-company">Hypergrowth AI</span>
                </div>
                <div class="history-body">
                    <h3 class="history-role">
                        Founding Engineer for Data Visualization
                    </h3>
                    <p class="history-desc">
                        Owned the dashboard product lifecycle from zero to IPO.
                        Built real-time analytics engines handling millions of
                        events per second.
                    </p>
                </div>
                <div class="history-tags">
                    <span class="tech-tag">React</span>
                    <span class="tech-tag">Python</span>
                    <span class="tech-tag">Redis</span>
                </div>
                <div class="history-outcome">
                    <span class="outcome-label">Business Outcome</span>
                    <span class="outcome-value">IPO readiness / Series C</span>
                </div>
            </article>

            <article
                class="history-row"
                data-recruiter-reveal="up"
                style="--stagger: 2;"
            >
                <div class="history-meta">
                    <span class="history-dates">2015 - 2018</span>
                    <span class="history-title">Full Stack Developer</span>
                    <span class="history-company">Digital Agency</span>
                </div>
                <div class="history-body">
                    <h3 class="history-role">Delivering E-commerce at Scale</h3>
                    <p class="history-desc">
                        Collaborated with Fortune 500 brands to build custom
                        headless commerce solutions with strong focus on
                        accessibility and performance.
                    </p>
                </div>
                <div class="history-tags">
                    <span class="tech-tag">Node.js</span>
                    <span class="tech-tag">GraphQL</span>
                    <span class="tech-tag">Next.js</span>
                </div>
                <div class="history-outcome">
                    <span class="outcome-label">Business Outcome</span>
                    <span class="outcome-value">9.8+ Lighthouse score</span>
                </div>
            </article>
        </div>
    </section>

    <section class="impact-section" id="contact">
        <div class="pillars-header">
            <h2 class="recruiter-section-heading">Impact Highlights</h2>
        </div>

        <div class="impact-grid-top">
            <article
                class="impact-card impact-card-main"
                data-recruiter-reveal="left"
                style="--stagger: 0;"
                data-tilt
            >
                <span class="impact-card-icon" aria-hidden="true">✧</span>
                <h3 class="impact-bigtext">
                    Increased Platform Throughput by <span
                        data-counter="450"
                        data-suffix="%">0%</span>
                </h3>
                <p>
                    Redesigned the internal cache-layer to handle peak loads
                    during Black Friday, resulting in zero downtime and
                    record-breaking revenue for our partners.
                </p>
                <a class="impact-cta interactive" href="#" data-sound="soft"
                    >Read Case Study <span aria-hidden="true">→</span></a
                >
            </article>

            <article
                class="impact-card impact-card-stat"
                data-recruiter-reveal="right"
                style="--stagger: 1;"
                data-tilt
            >
                <span class="stat-number"
                    ><span data-counter="12" data-suffix="k+">0k+</span></span
                >
                <span class="stat-label">Github stars contributed</span>
            </article>
        </div>

        <div class="impact-grid-bot">
            <article
                class="impact-card impact-card-small-stat"
                data-recruiter-reveal="up"
                style="--stagger: 2;"
                data-tilt
            >
                <span class="stat-number"><span data-counter="32">0</span></span
                >
                <span class="stat-label">Products launched</span>
            </article>

            <article
                class="impact-card impact-card-badge"
                data-recruiter-reveal="up"
                style="--stagger: 3;"
                data-tilt
            >
                <span class="badge-shield" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                        <path
                            d="M12 3 5 6v6c0 4 2.8 7.6 7 9 4.2-1.4 7-5 7-9V6l-7-3Z"
                            stroke="currentColor"
                            stroke-width="1.6"></path>
                        <path
                            d="m9.2 12.1 1.8 1.8 3.8-3.8"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </span>
            </article>

            <article
                class="impact-card impact-card-quote"
                data-recruiter-reveal="up"
                style="--stagger: 4;"
                data-tilt
            >
                <blockquote>
                    <p>
                        "One of the few engineers who truly understands the
                        business logic before writing a single line of code. A
                        rare asset."
                    </p>
                    <footer>- CTO, Global FinTech</footer>
                </blockquote>
            </article>
        </div>
    </section>
</main>
