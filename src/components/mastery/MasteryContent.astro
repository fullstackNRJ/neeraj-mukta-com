---
import "../../styles/pages/mastery.css";
---

<main class="mastery-page" id="architecture">
    <section class="mastery-shell mastery-hero">
        <p class="mastery-kicker" data-mastery-reveal style="--stagger: 0;">
            Engineered for performance
        </p>

        <h1 class="mastery-headline" data-mastery-reveal style="--stagger: 1;">
            <span>Scalable Architecture.</span>
            <span class="muted">Type-Safe Execution.</span>
        </h1>

        <p class="mastery-intro" data-mastery-reveal style="--stagger: 2;">
            From Hono.js on the Edge to enterprise-scale React and Angular
            systems. Specialized in crafting resilient ecosystems for the modern
            web.
        </p>

        <div class="mastery-actions" data-mastery-reveal style="--stagger: 3;">
            <a
                href="#case-studies"
                class="btn-primary interactive"
                data-sound="soft"
            >
                View Projects <span aria-hidden="true">-></span>
            </a>
            <a
                href="#stack"
                class="btn-secondary interactive"
                data-sound="bright"
            >
                Technical Stack
            </a>
        </div>
    </section>

    <section class="mastery-shell mastery-section" id="stack">
        <div class="section-heading" data-mastery-reveal style="--stagger: 0;">
            <p>Capabilities</p>
            <h2>Expertise Clusters</h2>
            <span class="shell-chip"
                >// node_modules/.bin/architect --version 4.2.0</span
            >
        </div>

        <div class="cluster-grid">
            <article
                class="cluster-card"
                data-mastery-reveal
                style="--stagger: 1;"
            >
                <span class="cluster-icon" aria-hidden="true">++</span>
                <h3>Modern Runtimes</h3>
                <ul>
                    <li>Node.js (LTS)</li>
                    <li>Hono.js (Edge-ready)</li>
                    <li>Astro (Island Arch)</li>
                </ul>
            </article>
            <article
                class="cluster-card"
                data-mastery-reveal
                style="--stagger: 2;"
            >
                <span class="cluster-icon" aria-hidden="true">&lt;&gt;</span>
                <h3>Framework Mastery</h3>
                <ul>
                    <li>React / Next.js</li>
                    <li>Angular Enterprise</li>
                    <li>Server Actions & RSCs</li>
                </ul>
            </article>
            <article
                class="cluster-card"
                data-mastery-reveal
                style="--stagger: 3;"
            >
                <span class="cluster-icon" aria-hidden="true">//</span>
                <h3>Scalable Tooling</h3>
                <ul>
                    <li>TypeScript (Advanced)</li>
                    <li>Turborepo / Monorepos</li>
                    <li>Vite & SWC Pipelines</li>
                </ul>
            </article>
        </div>
    </section>

    <section class="mastery-shell mastery-section" id="solutions">
        <div class="section-heading" data-mastery-reveal style="--stagger: 0;">
            <p>Execution</p>
            <h2>Technical Deep-Dive</h2>
        </div>

        <div class="deep-grid">
            <article
                class="deep-card deep-card-main"
                data-mastery-reveal
                style="--stagger: 1;"
            >
                <div>
                    <h3>System Design Patterns</h3>
                    <p>
                        Implementing hexagonal architecture and domain-driven
                        design in TypeScript environments. Designing for
                        horizontal scalability and high availability.
                    </p>
                    <div class="deep-tags">
                        <span>Microservices</span>
                        <span>Event-Driven</span>
                        <span>Serverless</span>
                    </div>
                </div>
            </article>

            <article
                class="deep-card deep-card-stat"
                data-mastery-reveal
                style="--stagger: 2;"
            >
                <p class="stat-title">Performance Optimization</p>
                <p class="stat-subtitle">Core Web Vitals & Latency</p>
                <p class="stat-value">99th</p>
                <p class="stat-label">Percentile Latency</p>
                <div class="mini-chart" aria-hidden="true">
                    <span style="--h: 34%;"></span>
                    <span style="--h: 44%;"></span>
                    <span style="--h: 37%;"></span>
                    <span style="--h: 58%;"></span>
                    <span style="--h: 77%;"></span>
                    <span style="--h: 47%;"></span>
                </div>
                <p class="stat-note">
                    Optimizing TBT and LCP through aggressive tree-shaking and
                    pre-fetching strategies.
                </p>
            </article>

            <article
                class="deep-card deep-card-mini"
                data-mastery-reveal
                style="--stagger: 3;"
            >
                <h4>Zero-Trust Auth</h4>
                <p>Clerk + Auth.js integration</p>
            </article>

            <article
                class="deep-card deep-card-mini"
                data-mastery-reveal
                style="--stagger: 4;"
            >
                <h4>Distributed SQL</h4>
                <p>Drizzle + PlanetScale</p>
            </article>
        </div>
    </section>

    <section class="mastery-shell mastery-section" id="case-studies">
        <div
            class="section-heading section-heading-row"
            data-mastery-reveal
            style="--stagger: 0;"
        >
            <div>
                <p>Portfolio</p>
                <h2>Case Study Grid</h2>
            </div>
            <a href="#" class="archive-link interactive" data-sound="soft"
                >View Archive</a
            >
        </div>

        <div class="study-grid">
            <article
                class="study-card"
                data-mastery-reveal
                style="--stagger: 1;"
            >
                <div
                    class="study-visual study-visual-organic"
                    aria-hidden="true"
                >
                </div>
                <span class="study-chip">Complex State</span>
                <h3>Enterprise API Orchestration</h3>
                <p>
                    Reduced cold-start latency by 45% using a custom middleware
                    layer for a global logistics provider handling 10k+
                    requests/sec.
                </p>
            </article>

            <article
                class="study-card"
                data-mastery-reveal
                style="--stagger: 2;"
            >
                <div
                    class="study-visual study-visual-geometric"
                    aria-hidden="true"
                >
                </div>
                <span class="study-chip">Scale</span>
                <h3>Real-time Dashboard Engine</h3>
                <p>
                    Engineered a high-frequency data visualizer for fintech
                    monitoring using Web Workers and specialized TanStack Query
                    configurations.
                </p>
            </article>
        </div>
    </section>

    <section
        class="mastery-shell mastery-cta"
        id="contact"
        data-mastery-reveal
        style="--stagger: 0;"
    >
        <h2>Need an Architect for your next build?</h2>
        <p>
            Available for high-stakes projects, code audits, and technical
            leadership roles.
        </p>
        <a href="#" class="cta-pill interactive" data-sound="bright"
            >Get in touch</a
        >
    </section>

    <footer class="mastery-shell mastery-footer">
        <p class="footer-brand">JS/TS Architect</p>
        <p class="footer-copy">
            (c) 2026. JS/TS architect. Built with precision.
        </p>
        <div class="footer-links">
            <a href="#" class="interactive" data-sound="soft">Documentation</a>
            <a href="#" class="interactive" data-sound="soft">GitHub</a>
            <a href="#" class="interactive" data-sound="soft">LinkedIn</a>
            <a href="#" class="interactive" data-sound="soft">Privacy</a>
        </div>
        <button
            id="masteryThemeToggle"
            class="mastery-theme-toggle interactive"
            aria-label="Toggle dark and light mode"
            data-sound="bright"
        >
            <span>Theme</span>
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
        </button>
    </footer>
</main>
