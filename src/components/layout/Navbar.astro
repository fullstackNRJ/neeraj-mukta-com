<header class="nav-shell nav-animate">
    <nav class="floating-nav">
        <a class="brand" href="/">NM</a>
        <ul class="nav-links">
            <li><a href="/#work">Work</a></li>
            <li><a href="/#services">Services</a></li>
            <li><a href="/#archive">About</a></li>
        </ul>
        <div class="nav-actions">
            <!-- Page IA / Design token info card toggle -->
            <div class="ia-popover-wrap">
                <button
                    type="button"
                    id="iaToggle"
                    class="icon-btn interactive"
                    aria-label="Site info"
                    aria-expanded="false"
                    aria-controls="ia-panel"
                    data-sound="soft"
                >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
                        <path d="M12 8h.01M12 11v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
                <div id="ia-panel" class="ia-panel" hidden role="dialog" aria-label="Site information">
                    <p class="ia-heading">Site IA</p>
                    <ul class="ia-pages">
                        <li><a href="/">Home</a></li>
                        <li><a href="/startup-founder">Startup Founder</a></li>
                        <li><a href="/recruiter">Recruiter</a></li>
                        <li><a href="/for-agencies">Agency Partner</a></li>
                        <li><a href="/for-marketing">Growth Engineering</a></li>
                        <li><a href="/journal">Journal</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                    <p class="ia-heading">Design Tokens</p>
                    <div class="ia-tokens">
                        <div class="token-row">
                            <span class="token-swatch" style="background:var(--primary)"></span>
                            <span class="token-label">Primary</span>
                            <code class="token-value">#b7f7de</code>
                        </div>
                        <div class="token-row">
                            <span class="token-swatch" style="background:var(--surface)"></span>
                            <span class="token-label">Surface</span>
                            <code class="token-value">#0e0e0e</code>
                        </div>
                        <div class="token-row">
                            <span class="token-swatch" style="background:var(--surface-container-high)"></span>
                            <span class="token-label">Container</span>
                            <code class="token-value">#202122</code>
                        </div>
                    </div>
                    <p class="ia-heading">Typography</p>
                    <p class="ia-font">Inter — 100–900</p>
                </div>
            </div>
            <!-- Dark / Light mode toggle -->
            <button
                id="themeToggleNav"
                type="button"
                class="icon-btn theme-icon-btn interactive"
                aria-label="Toggle light and dark mode"
                data-sound="soft"
            >
                <!-- Sun icon (shown in dark mode) -->
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2m-3.05-7.95-1.41 1.41M5.46 18.54l-1.41 1.41M18.95 18.54l-1.41-1.41M5.46 5.46 4.05 4.05" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
                <!-- Moon icon (shown in light mode) -->
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
    </nav>
</header>
