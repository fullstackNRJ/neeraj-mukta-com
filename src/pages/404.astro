---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import BackgroundEffects from "../components/layout/BackgroundEffects.astro";

const seo = {
    title: "Page Not Found | Neeraj Mukta",
    description: "The page you were looking for could not be found.",
    noindex: true,
};
---

<BaseLayout {...seo}>
    <BackgroundEffects />
    <Navbar />
    <main class="layout not-found-page" id="main-content">
        <section class="not-found-hero">
            <p class="label">404</p>
            <h1>Page Not Found</h1>
            <p class="not-found-body">
                The page you were looking for doesn't exist or has been moved.
            </p>
            <a class="btn btn-primary" href="/">Go Back Home</a>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
    .not-found-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
    }

    .not-found-hero {
        text-align: center;
        max-width: 40ch;
    }

    .not-found-hero h1 {
        margin: 0.5rem 0;
        font-size: clamp(2rem, 6vw, 3.5rem);
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .not-found-body {
        color: var(--on-surface-variant);
        margin: 0 0 1.5rem;
    }
</style>
